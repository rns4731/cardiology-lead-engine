{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose up --build -d:*)",
      "Bash(docker compose --profile test run --rm tests:*)",
      "Bash(docker compose run --rm --no-deps exporter python -m engine:*)",
      "Bash(docker compose run --rm --no-deps exporter python run.py:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(scripts/smoke.sh:*)",
      "Bash(npm --prefix web run typecheck:*)",
      "Bash(npm --prefix web run build:*)",
      "Bash(npm --prefix web test:*)",
      "Bash(npm --prefix web run dev:*)",
      "Bash(node web/scripts/screenshots.mjs:*)",
      "Bash(WIDTH=400 node web/scripts/screenshots.mjs:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/engine-changed.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
