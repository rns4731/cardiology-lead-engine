{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m engine.export_web --offline:*)",
      "Bash(.venv/bin/python -m engine.bundle_check:*)",
      "Bash(.venv/bin/python -m engine.scoring:*)",
      "Bash(.venv/bin/python -m engine.clustering:*)",
      "Bash(.venv/bin/python run.py:*)",
      "Bash(scripts/smoke.sh:*)",
      "Bash(npm --prefix web run typecheck:*)",
      "Bash(npm --prefix web run build:*)",
      "Bash(npm --prefix web test:*)",
      "Bash(npm --prefix web run dev:*)",
      "Bash(node web/scripts/screenshots.mjs:*)",
      "Bash(WIDTH=400 node web/scripts/screenshots.mjs:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/engine-changed.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
